{
  "name": "@uyghurcommunity/ui-react",
  "version": "0.4.0",
  "description": "Optional React adapters for Uyghur UI, including accessible RTL writing and cultural interactions.",
  "type": "module",
  "license": "MIT",
  "author": "UyghurCommunity",
  "engines": { "node": ">=20" },
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.js" }, "./package.json": "./package.json" },
  "files": ["src", "example/index.html", "example/main.js", "example/style.css", "example/package.json", "example/vite.config.js", "example/README.md", "README.md", "LICENSE"],
  "sideEffects": false,
  "peerDependencies": { "react": ">=18 <20", "react-dom": ">=18 <20", "@uyghurcommunity/ui": ">=0.4.0 <1" },
  "devDependencies": { "@uyghurcommunity/ui": "file:../..", "react": "^18.3.1", "react-dom": "^18.3.1", "jsdom": "^24.1.3", "typescript": "^5.6.3", "@types/react": "^18.3.0", "@types/react-dom": "^18.3.0" },
  "scripts": { "test": "node --test test/*.test.js", "check": "node --check src/index.js", "build:presets": "node scripts/build-presets.mjs" },
  "repository": { "type": "git", "url": "https://github.com/UyghurCommunity/uyghur-ui.git", "directory": "packages/react" },
  "homepage": "https://uyghurcommunity.github.io/uyghur-ui/",
  "keywords": ["uyghur", "react", "rtl", "components", "accessibility"],
  "publishConfig": { "access": "public" }
}
